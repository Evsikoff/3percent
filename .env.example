# --- Gmail (OAuth client of type "Desktop app"; refresh token from `npm run token`) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Which mail counts as incoming (default below). `after:<time>` is added automatically.
# GMAIL_QUERY=-in:sent -in:draft -in:chats

# Label IDs, defaults are the ones from the n8n workflow
# LABEL_OK=Label_904891371254780187
# LABEL_NO_QUOTE=Label_4180071384748807826
# LABEL_BITRIX_ERROR=Label_7629150265200231247
# LABEL_AI_ERROR=Label_846358029050760511

# --- Gemini (direct by default; set GEMINI_BASE_URL to use the Cloudflare Worker proxy) ---
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_RETRY_MODEL=gemini-3.1-pro-preview

# --- OpenAI, optional fallback for retries ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.2

# --- Bitrix24: incoming webhook URL without the method name ---
BITRIX_WEBHOOK_URL=https://b24-xxxxxx.bitrix24.ru/rest/<user_id>/<token>
# BITRIX_AUTHOR_ID=66
# BITRIX_ENTITY_TYPE=quote

# --- Supabase: project URL and secret key (sb_secret_..., or legacy service_role); not the publishable key ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=
# SUPABASE_TABLE=missed_messages

# --- Schedule ---
# POLL_INTERVAL_SEC=60
# RETRY_INTERVAL_MIN=10
# On start, mail newer than this is checked (catch-up after downtime). Without it: last STARTUP_LOOKBACK_HOURS.
# PROCESS_AFTER=2026-10-25
# STARTUP_LOOKBACK_HOURS=24

# true = read mail and call AI, but write nothing (no labels, no Bitrix, no Supabase); runs one pass
# DRY_RUN=true
